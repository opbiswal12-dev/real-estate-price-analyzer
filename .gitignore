        ]
    )


def scrape_real_estate_page(url: str, output_path: str) -> pd.DataFrame:
    """Attempt to parse house data from a real-estate page.

    Real listing pages often use varied CSS classes, so this function tries a few common patterns and
    falls back to a synthetic dataset so the project remains runnable without internet access.
    """
    try:
        response = requests.get(url, timeout=15)
        response.raise_for_status()
        soup = BeautifulSoup(response.text, "html.parser")

        records = []
        selectors = [
            "article",
            ".property-card",
            ".listing-card",
            "[data-testid='property-card']",
            "li",
        ]

        for selector in selectors:
            items = soup.select(selector)
            for item in items:
                text = item.get_text(" ", strip=True)
                if not text:
                    continue
                if "$" not in text and "price" not in text.lower():
                    continue

                location = item.get("data-address") or item.get("data-location")
                location = location or "Unknown"
                price = None
                for candidate in item.select("span, div, h3, p"):
                    candidate_text = candidate.get_text(" ", strip=True)
                    if "$" in candidate_text:
                        price = candidate_text
                        break
                if price is None:
                    continue

                records.append(
                    {
                        "location": location,
                        "price": _parse_currency(price),
                        "bedrooms": _parse_int(item.get("data-bedrooms")),
                        "bathrooms": _parse_int(item.get("data-bathrooms")),
                        "area_sqft": _parse_int(item.get("data-area")),
                        "has_pool": 0,
                        "has_garage": 0,
                        "has_parking": 1,
                        "has_garden": 0,
                        "has_lake_view": 0,
                    }
                )

        if records:
            df = pd.DataFrame(records)
            output_file = Path(output_path)
            output_file.parent.mkdir(parents=True, exist_ok=True)
            df.to_csv(output_file, index=False)
            return df
    except Exception:
        pass

    df = _generate_sample_dataset()
    output_file = Path(output_path)
    output_file.parent.mkdir(parents=True, exist_ok=True)
    df.to_csv(output_file, index=False)
    return df
